    --main-bg-color: #ac3e31;
    --main-bg-highlight: #712921;
    --alternate-bg-color: #f1f3f2;
    --btn-color: #c6c6c6;
    --btn-highlight: #a3a3a3;
}

.list-group{
    align-items: center;
}
.invHeader{
    text-align: center;
    font-family: "Inter", sans-serif;
    font-optical-sizing: auto;
    font-weight: 800;
    font-style:normal;
}
.inventoryTable{
    width:50%; 
    border: 9px solid var(--main-bg-color);
    border-spacing: 0;
    border-collapse: separate;
    border-radius: 10px;
    border-left: none;
    border-right: none;
}
.inventoryHeader{
    background-color: var(--main-bg-color);
    color: var(--alternate-bg-color);
    text-align:center;
    
}
.inventoryHeader > th{
    padding: 5px;
    font-weight:bold;
}
.inventoryTable > tbody > tr > td{
    padding: 5px;
    text-align: left;
}
td{
    white-space: nowrap;
    text-align:center;
}
tr:nth-child(even){
    background-color: var(--alternate-bg-color);
}
.inventoryTable input[type=text]{
    border-radius: 10px;
    border-collapse: separate;
    border-color: white;
    border-spacing: 0px;
    border:none;
    background-color:inherit;
}
.deleteBtn{
    border:none;
    padding: 5px;
}
.tableBtn{
    border-radius:5px;
    border: none;
    padding: 5px;
    background-color: inherit;
}
.searchContainer{
    width:100%;
    align-items: center;
    padding: 15px;
}
.searchContainer form{
    width:100%;
}
.searchBar{
    width: 100%;
    padding: 10px;
    border: 1px solid var(--alternate-bg-color) !important;
    border-radius: 10px;
    background-color: var(--alternate-bg-color); 
}
.inventoryTable > tbody{
    border-radius: 5px;
    border: 1px solid black;
    border-collapse: separate;
}
.btnText{
    font-weight:700;
}
.update{
    column-span:all;
    background-color:white;
    border: 1px solid black;
}
.tableBtn:hover{
    color: var(--btn-highlight);
    padding-bottom: 3px;
}
.tableBtn:hover > img{
    padding-top: 3px;
}`, "",{"version":3,"sources":["webpack://./src/styles/inventorylist.css"],"names":[],"mappings":"AAAA;IACI,wBAAwB;IACxB,4BAA4B;IAC5B,6BAA6B;IAC7B,oBAAoB;IACpB,wBAAwB;AAC5B;;AAEA;IACI,mBAAmB;AACvB;AACA;IACI,kBAAkB;IAClB,gCAAgC;IAChC,yBAAyB;IACzB,gBAAgB;IAChB,iBAAiB;AACrB;AACA;IACI,SAAS;IACT,sCAAsC;IACtC,iBAAiB;IACjB,yBAAyB;IACzB,mBAAmB;IACnB,iBAAiB;IACjB,kBAAkB;AACtB;AACA;IACI,sCAAsC;IACtC,gCAAgC;IAChC,iBAAiB;;AAErB;AACA;IACI,YAAY;IACZ,gBAAgB;AACpB;AACA;IACI,YAAY;IACZ,gBAAgB;AACpB;AACA;IACI,mBAAmB;IACnB,iBAAiB;AACrB;AACA;IACI,2CAA2C;AAC/C;AACA;IACI,mBAAmB;IACnB,yBAAyB;IACzB,mBAAmB;IACnB,mBAAmB;IACnB,WAAW;IACX,wBAAwB;AAC5B;AACA;IACI,WAAW;IACX,YAAY;AAChB;AACA;IACI,iBAAiB;IACjB,YAAY;IACZ,YAAY;IACZ,yBAAyB;AAC7B;AACA;IACI,UAAU;IACV,mBAAmB;IACnB,aAAa;AACjB;AACA;IACI,UAAU;AACd;AACA;IACI,WAAW;IACX,aAAa;IACb,sDAAsD;IACtD,mBAAmB;IACnB,2CAA2C;AAC/C;AACA;IACI,kBAAkB;IAClB,uBAAuB;IACvB,yBAAyB;AAC7B;AACA;IACI,eAAe;AACnB;AACA;IACI,eAAe;IACf,sBAAsB;IACtB,uBAAuB;AAC3B;AACA;IACI,2BAA2B;IAC3B,mBAAmB;AACvB;AACA;IACI,gBAAgB;AACpB","sourcesContent":[":root{\r\n    --main-bg-color: #ac3e31;\r\n    --main-bg-highlight: #712921;\r\n    --alternate-bg-color: #f1f3f2;\r\n    --btn-color: #c6c6c6;\r\n    --btn-highlight: #a3a3a3;\r\n}\r\n\r\n.list-group{\r\n    align-items: center;\r\n}\r\n.invHeader{\r\n    text-align: center;\r\n    font-family: \"Inter\", sans-serif;\r\n    font-optical-sizing: auto;\r\n    font-weight: 800;\r\n    font-style:normal;\r\n}\r\n.inventoryTable{\r\n    width:50%; \r\n    border: 9px solid var(--main-bg-color);\r\n    border-spacing: 0;\r\n    border-collapse: separate;\r\n    border-radius: 10px;\r\n    border-left: none;\r\n    border-right: none;\r\n}\r\n.inventoryHeader{\r\n    background-color: var(--main-bg-color);\r\n    color: var(--alternate-bg-color);\r\n    text-align:center;\r\n    \r\n}\r\n.inventoryHeader > th{\r\n    padding: 5px;\r\n    font-weight:bold;\r\n}\r\n.inventoryTable > tbody > tr > td{\r\n    padding: 5px;\r\n    text-align: left;\r\n}