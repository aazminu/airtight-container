___CSS_LOADER_EXPORT___.push([module.id, `div.invoice{
    max-width:950px;
    max-height:1320px;
}
div.invTop{
    flex:1 1;
}
div.invTitle{
    float: left;
}
div.invLogo{
    width: 40%;
    float:right;
}
div.invDate{
    padding-top:20px;
    clear:left;
    float:left;
}
img.invLogo{
    width: 100%; /* or any custom size */
    height: 100%; 
    object-fit: contain;
}
p.invSubHead{
    color:gray;
}
h1.invTitle{
    color:#B8CCE4;
    font-size: 60px;
}
div.invAddresses{
    clear:left;
    float:left;
    display:flex;
    width:-moz-fit-content;
    width:fit-content;
    padding-top:80px;
    padding-bottom: 30px;
}
span.invAddress{
    font-size:16px;
    padding-left:10px;
}
div.invAddresses > p {
    padding-right: 25px;
    padding-left: 25px;
    color:#2192CF;
}
div.deliverTo{
    clear:both;
}
div.deliverTo > p {
    background-color: yellow;
    width:-moz-fit-content;
    width:fit-content;
    margin-inline:auto;
    font-weight:bold;
}
div.invTable{
    width: 100%;
    margin-inline: auto;
}
div.invTable > table {
    width:100%;
}
div.invTable > table > thead > tr{
    background-color:#DBE5F1;
    border-top:2px solid grey;
    color: #215868;
    font-weight: bolder;
    text-align: center;
}
tr.invTableRow > td {
    border-left: 2px solid grey;
    border-right: 2px solid grey;
    padding: 5px;
    font-size:12px;
}`, "",{"version":3,"sources":["webpack://./src/styles/invoice.css"],"names":[],"mappings":"AAAA;IACI,eAAe;IACf,iBAAiB;AACrB;AACA;IACI,QAAM;AACV;AACA;IACI,WAAW;AACf;AACA;IACI,UAAU;IACV,WAAW;AACf;AACA;IACI,gBAAgB;IAChB,UAAU;IACV,UAAU;AACd;AACA;IACI,WAAW,EAAE,uBAAuB;IACpC,YAAY;IACZ,mBAAmB;AACvB;AACA;IACI,UAAU;AACd;AACA;IACI,aAAa;IACb,eAAe;AACnB;AACA;IACI,UAAU;IACV,UAAU;IACV,YAAY;IACZ,sBAAiB;IAAjB,iBAAiB;IACjB,gBAAgB;IAChB,oBAAoB;AACxB;AACA;IACI,cAAc;IACd,iBAAiB;AACrB;AACA;IACI,mBAAmB;IACnB,kBAAkB;IAClB,aAAa;AACjB;AACA;IACI,UAAU;AACd;AACA;IACI,wBAAwB;IACxB,sBAAiB;IAAjB,iBAAiB;IACjB,kBAAkB;IAClB,gBAAgB;AACpB;AACA;IACI,WAAW;IACX,mBAAmB;AACvB;AACA;IACI,UAAU;AACd;AACA;IACI,wBAAwB;IACxB,yBAAyB;IACzB,cAAc;IACd,mBAAmB;IACnB,kBAAkB;AACtB;AACA;IACI,2BAA2B;IAC3B,4BAA4B;IAC5B,YAAY;IACZ,cAAc;AAClB","sourcesContent":["div.invoice{\r\n    max-width:950px;\r\n    max-height:1320px;\r\n}\r\ndiv.invTop{\r\n    flex:1;\r\n}\r\ndiv.invTitle{\r\n    float: left;\r\n}\r\ndiv.invLogo{\r\n    width: 40%;\r\n    float:right;\r\n}\r\ndiv.invDate{\r\n    padding-top:20px;\r\n    clear:left;\r\n    float:left;\r\n}\r\nimg.invLogo{\r\n    width: 100%; /* or any custom size */\r\n    height: 100%; \r\n    object-fit: contain;\r\n}\r\np.invSubHead{\r\n    color:gray;\r\n}\r\nh1.invTitle{\r\n    color:#B8CCE4;\r\n    font-size: 60px;\r\n}\r\ndiv.invAddresses{\r\n    clear:left;\r\n    float:left;\r\n    display:flex;\r\n    width:fit-content;\r\n    padding-top:80px;\r\n    padding-bottom: 30px;\r\n}\r\nspan.invAddress{\r\n    font-size:16px;\r\n    padding-left:10px;\r\n}\r\ndiv.invAddresses > p {\r\n    padding-right: 25px;\r\n    padding-left: 25px;\r\n    color:#2192CF;\r\n}\r\ndiv.deliverTo{\r\n    clear:both;\r\n}\r\ndiv.deliverTo > p {\r\n    background-color: yellow;\r\n    width:fit-content;\r\n    margin-inline:auto;\r\n    font-weight:bold;\r\n}\r\ndiv.invTable{\r\n    width: 100%;\r\n    margin-inline: auto;\r\n}\r\ndiv.invTable > table {\r\n    width:100%;\r\n}\r\ndiv.invTable > table >