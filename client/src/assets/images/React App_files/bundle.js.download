___CSS_LOADER_EXPORT___.push([module.id, `nav{
    position:sticky;
}
.printout > div{
    display:flex;
    flex-direction: column;
    max-width:950px;
    max-height:1320px;
}
.header{
    justify-content: center;
    text-align:center;
}
h1.topper{
   font-size:20px; 
}
.title{
    color:red;
    font-weight: bold;
}
.bg{
    background-color:white;
    z-index: 1;
    top:0px;
    width: max-content;
}
div.areadiv {
    display:block
}
p.area {
    font-weight:500;
    line-height: 2;
    position:relative;
    left:0px;
    font-size: 13.7px;
    text-align:left;
}
.bold{
    font-weight:bold;
}
span.address{
    display:inline-block;
    padding-left:10px;
}
span.outer{
    display:flex;
    width:-moz-fit-content;
    width:fit-content;
    border:solid;
    padding: 5px;
}`, "",{"version":3,"sources":["webpack://./src/styles/deliverysheet.css"],"names":[],"mappings":"AAAA;IACI,eAAe;AACnB;AACA;IACI,YAAY;IACZ,sBAAsB;IACtB,eAAe;IACf,iBAAiB;AACrB;AACA;IACI,uBAAuB;IACvB,iBAAiB;AACrB;AACA;GACG,cAAc;AACjB;AACA;IACI,SAAS;IACT,iBAAiB;AACrB;AACA;IACI,sBAAsB;IACtB,UAAU;IACV,OAAO;IACP,kBAAkB;AACtB;AACA;IACI;AACJ;AACA;IACI,eAAe;IACf,cAAc;IACd,iBAAiB;IACjB,QAAQ;IACR,iBAAiB;IACjB,eAAe;AACnB;AACA;IACI,gBAAgB;AACpB;AACA;IACI,oBAAoB;IACpB,iBAAiB;AACrB;AACA;IACI,YAAY;IACZ,sBAAiB;IAAjB,iBAAiB;IACjB,YAAY;IACZ,YAAY;AAChB","sourcesContent":["nav{\r\n    position:sticky;\r\n}\r\n.printout > div{\r\n    display:flex;\r\n    flex-direction: column;\r\n    max-width:950px;\r\n    max-height:1320px;\r\n}\r\n.header{\r\n    justify-content: center;\r\n    text-align:center;\r\n}\r\nh1.topper{\r\n   font-size:20px; \r\n}\r\n.title{\r\n    color:red;\r\n    font-weight: bold;\r\n}\r\n.bg{\r\n    background-color:white;\r\n    z-index: 1;\r\n    top:0px;\r\n    width: max-content;\r\n}\r\ndiv.areadiv {\r\n    display:block\r\n}\r\np.area {\r\n    font-weight:500;\r\n    line-height: 2;\r\n    position:relative;\r\n    left:0px;\r\n    font-size: 13.7px;\r\n    text-align:left;\r\n}\r\n.bold{\r\n    font-weight:bold;\r\n}\r\nspan.address{\r\n    display:inline-block;\r\n    padding-left:10px;\r\n}\r\nspan.outer{\r\n    display:flex;\r\n    width:fit-content;\r\n    border:solid;\r\n    padding: 5px;\r\n}"],"sourceRoot":""}]);
