___CSS_LOADER_EXPORT___.push([module.id, `.navbar{
    display:flex;
    align-items: center;
    justify-content: center;
    justify-content: space-between;
    height:100%;
    width: 90%;
    margin:auto;
}
.navbar ul {
    display: flex;
}
.navbar ul li {
    list-style-type: none;
}
 .navbar img {
    padding: 5px;
 }
.navbar a{
    padding: 5px;
    text-decoration: none;
    color:black;
    font-weight: 500;
}
.navbar a:hover{
    color: var(--main-bg-color)
}`, "",{"version":3,"sources":["webpack://./src/styles/navbar.css"],"names":[],"mappings":"AAAA;IACI,YAAY;IACZ,mBAAmB;IACnB,uBAAuB;IACvB,8BAA8B;IAC9B,WAAW;IACX,UAAU;IACV,WAAW;AACf;AACA;IACI,aAAa;AACjB;AACA;IACI,qBAAqB;AACzB;CACC;IACG,YAAY;CACf;AACD;IACI,YAAY;IACZ,qBAAqB;IACrB,WAAW;IACX,gBAAgB;AACpB;AACA;IACI;AACJ","sourcesContent":[".navbar{\r\n    display:flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    justify-content: space-between;\r\n    height:100%;\r\n    width: 90%;\r\n    margin:auto;\r\n}\r\n.navbar ul {\r\n    display: flex;\r\n}\r\n.navbar ul li {\r\n    list-style-type: none;\r\n}\r\n .navbar img {\r\n    padding: 5px;\r\n }\r\n.navbar a{\r\n    padding: 5px;\r\n    text-decoration: none;\r\n    color:black;\r\n    font-weight: 500;\r\n}\r\n.navbar a:hover{\r\n    color: var(--main-bg-color)\r\n}"],"sourceRoot":""}]);
